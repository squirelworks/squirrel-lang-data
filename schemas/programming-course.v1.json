{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/squirelworks/squirrel-lang-data/schemas/programming-course.v1.json",
  "title": "programming-course@1: one Programming Learner course",
  "description": "programming/<id>/course.json: lessons, keywords and practice for one language or track. Apps generate their JS packs from these files.",
  "type": "object",
  "required": ["schema", "id", "name", "title", "intro", "lessons"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "h": { "description": "Heading.", "type": "string", "minLength": 1 },
        "p": { "description": "Paragraph; may hold trusted HTML such as <code> and <b>.", "type": "string", "minLength": 1 },
        "code": { "description": "Example program or snippet.", "type": "string", "minLength": 1 },
        "out": { "description": "Exact printed output of code, when the course has a runner.", "type": "string" }
      }
    },
    "question": {
      "type": "object",
      "required": ["q", "options", "answer", "why"],
      "additionalProperties": false,
      "properties": {
        "q": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
        "answer": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "output: answer is exactly what code prints; the Desk runner checks it.",
          "enum": ["output"]
        }
      }
    }
  },
  "properties": {
    "schema": { "const": "programming-course@1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "intro": { "type": "string", "minLength": 1 },
    "comment": { "description": "Line-comment marker shown in the UI, e.g. # or //.", "type": "string" },
    "keywords": {
      "description": "Reserved words highlighted in the course.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "builtins": {
      "description": "Common built-in names highlighted alongside keywords.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "sections"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/section" }
          },
          "practice": {
            "type": "array",
            "items": { "$ref": "#/$defs/question" }
          }
        }
      }
    }
  }
}
