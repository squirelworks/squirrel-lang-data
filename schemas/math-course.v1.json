{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/squirelworks/squirrel-lang-data/schemas/math-course.v1.json",
  "title": "math-course@1: one Math Learner course",
  "description": "math/<id>/course.json: lessons and practice for one math subject. Apps generate their JS packs from these files.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "title",
    "intro",
    "lessons"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "h": {
          "description": "Heading.",
          "type": "string",
          "minLength": 1
        },
        "p": {
          "description": "Paragraph; may hold trusted HTML such as <code> and <b>.",
          "type": "string",
          "minLength": 1
        },
        "code": {
          "description": "Worked example in plain text.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "q",
        "options",
        "answer",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "math-course@1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "sections"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/section"
            }
          },
          "practice": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/question"
            }
          }
        }
      }
    }
  }
}
