{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/squirelworks/squirrel-lang-data/schemas/klingon.v1.json",
  "title": "klingon@1: the pIqaD course for SquirrelGo Klingon",
  "description": "alphabets/klingon.json: the pIqaD letters and numerals in lessons, the sound of each letter, a few practice words, and the articles. pIqaD sits in the ConScript Unicode Registry's private-use code points (U+F8D0 to U+F8FF), so each letter is named by its romanization.",
  "type": "object",
  "required": ["schema", "ipa", "lessons", "words", "articles"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "klingon@1" },
    "notes": { "description": "How the course is written, one sentence or line each.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ipa": { "description": "IPA for each letter, by romanization; used for display and to make the recordings.", "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "chars"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "numerals": { "description": "The lesson teaches digits, not letters.", "const": true },
          "note": { "type": "string", "minLength": 1 },
          "chars": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["roman", "codepoint", "say", "soundsLike", "example", "meaning"],
              "additionalProperties": false,
              "properties": {
                "roman": { "description": "The letter's romanization (or the digit); its key in strokes/klingon.jsonl.", "type": "string", "minLength": 1 },
                "codepoint": { "description": "The pIqaD glyph's code point, U+F8D0 to U+F8FF.", "type": "integer" },
                "say": { "description": "How to say it.", "type": "string", "minLength": 1 },
                "soundsLike": { "description": "An English-spelled approximation.", "type": "string", "minLength": 1 },
                "example": { "description": "An example word in romanization.", "type": "string", "minLength": 1 },
                "meaning": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "words": { "description": "Practice words, each [word, meaning].", "type": "array", "items": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } } },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "body": { "description": "HTML.", "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
